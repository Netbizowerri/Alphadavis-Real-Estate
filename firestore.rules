rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        request.auth.token.email == 'netbiz0925@gmail.com' ||
        request.auth.token.email == 'alphadavis@gmail.com'
      );
    }

    // --- COLLECTIONS ---

    // PROPERTIES - public read if published, admin full control
    match /properties/{propertyId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      // Allow admin to create with any valid data
      allow create: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.isPublished is bool;
      // Allow admin to update any property fields
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // CATEGORIES - public read, admin full control
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // FORM SUBMISSIONS
    match /consultationRequests/{requestId} {
      allow create: if
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    match /propertyRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contactMessages/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /serviceBookings/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }
  }
}
